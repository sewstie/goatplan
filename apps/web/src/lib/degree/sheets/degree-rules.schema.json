{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*-[0-9]{4}$"
    },
    "major": {
      "type": "string",
      "minLength": 1
    },
    "classYear": {
      "type": "integer",
      "minimum": 2000
    },
    "catalogYear": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{4}$"
    },
    "effectiveDate": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "catalogSource": {
      "type": "string",
      "format": "uri"
    },
    "totalUnits": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "residencyUnits": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "minUnits": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "creditPool": {
            "const": true
          },
          "poolCredits": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "minUnits",
          "lines"
        ],
        "additionalProperties": false,
        "dependencies": {
          "creditPool": [
            "poolCredits"
          ]
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "filter": {
            "$ref": "#/definitions/filter"
          },
          "subSlots": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "subSlotUnits": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "areaTag": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "line",
          "section",
          "name",
          "units",
          "filter"
        ],
        "additionalProperties": false,
        "dependencies": {
          "subSlots": [
            "subSlotUnits"
          ]
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "course": {
            "type": "string",
            "pattern": "^[A-Z]{2,4} [0-9]{3,4}[A-Z]?$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "course",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "onlyOneSets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "courses": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2,4} [0-9]{3,4}[A-Z]?$"
            },
            "minItems": 2,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "courses",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "crossLists": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Z]{2,4} [0-9]{3,4}[A-Z]?$"
        },
        "minItems": 2,
        "maxItems": 2,
        "uniqueItems": true
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "area",
              "disciplineCount",
              "groupDepth",
              "groupBreadth",
              "apIbLimit",
              "residency",
              "levelLimit",
              "graduateEquivalence",
              "minCourses",
              "manual"
            ]
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "courses": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2,4} [0-9]{3,4}[A-Z]?$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "externalCourses": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2,4} [0-9]{3,4}[A-Z]?$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "disciplines": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2,4}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "displayCourses": {
            "type": "integer",
            "minimum": 1
          },
          "minFromOneDiscipline": {
            "type": "integer",
            "minimum": 1
          },
          "minCourses": {
            "type": "integer",
            "minimum": 1
          },
          "confirmation": {
            "type": "string",
            "minLength": 1
          },
          "requiresConfirmation": {
            "type": "boolean"
          },
          "groupings": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{2,4}$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "groupingOrder": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "exceptionGrouping": {
            "type": "string",
            "minLength": 1
          },
          "depthCheck": {
            "type": "string",
            "minLength": 1
          },
          "allLanguageException": {
            "type": "boolean"
          },
          "maxApIb": {
            "type": "integer",
            "minimum": 0
          },
          "minUnits": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxCourses": {
            "type": "integer",
            "minimum": 1
          },
          "levelCeiling": {
            "type": "integer",
            "minimum": 1
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "help": {
            "type": "string",
            "minLength": 1
          },
          "affectsLines": {
            "type": "boolean"
          },
          "hideWhenEmpty": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "type"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "area"
                }
              }
            },
            "then": {
              "required": [
                "section",
                "courses"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "disciplineCount"
                }
              }
            },
            "then": {
              "required": [
                "section",
                "disciplines",
                "displayCourses",
                "minFromOneDiscipline"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "groupDepth"
                }
              }
            },
            "then": {
              "required": [
                "section",
                "lines",
                "minCourses",
                "confirmation"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "groupBreadth"
                }
              }
            },
            "then": {
              "required": [
                "section",
                "groupings",
                "groupingOrder",
                "depthCheck"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "apIbLimit"
                }
              }
            },
            "then": {
              "required": [
                "section",
                "maxApIb"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "residency"
                }
              }
            },
            "then": {
              "required": [
                "minUnits"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "levelLimit"
                }
              }
            },
            "then": {
              "required": [
                "section",
                "maxCourses",
                "levelCeiling"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "graduateEquivalence"
                }
              }
            },
            "then": {
              "required": [
                "section"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "minCourses"
                }
              }
            },
            "then": {
              "required": [
                "section",
                "minCourses"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "manual"
                }
              }
            },
            "then": {
              "required": [
                "confirmation"
              ]
            }
          }
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "manualItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "const": "checkbox"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "type"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "huaSubjects": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,4}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "orderNote": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "$schema",
    "id",
    "major",
    "classYear",
    "catalogYear",
    "effectiveDate",
    "source",
    "catalogSource",
    "totalUnits",
    "residencyUnits",
    "sections",
    "lines",
    "exclusions",
    "onlyOneSets",
    "crossLists",
    "checks",
    "manualItems",
    "huaSubjects",
    "orderNote"
  ],
  "additionalProperties": false,
  "definitions": {
    "filter": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "courses",
            "subjects",
            "subjectMinLevel",
            "manual",
            "any"
          ]
        },
        "subject": {
          "type": "string",
          "pattern": "^[A-Z]{2,4}$"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2,4}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "courses": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2,4} [0-9]{3,4}[A-Z]?$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "minLevel": {
          "type": "integer",
          "minimum": 0
        },
        "additionalCourses": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2,4} [0-9]{3,4}[A-Z]?$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "excludedCourses": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2,4} [0-9]{3,4}[A-Z]?$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "priority": {
          "type": "integer"
        },
        "advanced": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "courses"
              }
            }
          },
          "then": {
            "required": [
              "courses"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "subjects"
              }
            }
          },
          "then": {
            "required": [
              "subjects"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "subjectMinLevel"
              }
            }
          },
          "then": {
            "required": [
              "subject",
              "minLevel"
            ]
          }
        }
      ]
    }
  }
}
